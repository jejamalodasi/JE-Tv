APP_NAME=JE TV
APP_VERSION=2.0.0
MAINTENANCE=false
FORCE_UPDATE=false

# Google Sheet = single source of truth
GOOGLE_SHEET_ID=
GOOGLE_SHEET_GID=0
# Alternatively, use a published CSV:
GOOGLE_SHEET_CSV_URL=

# Cache for serverless API. Keep short so Sheet edits propagate quickly.
SHEET_CACHE_MS=15000

# Client polling interval.
CLIENT_REFRESH_MS=30000

# Secret used by Google Apps Script to force immediate cache refresh.
SHEET_SYNC_SECRET=

# Existing application secrets
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD_SHA256=
